# Copy to .env.local (untracked) and fill in real values.

# Postgres started by docker compose (local only).
POSTGRES_PASSWORD=
# Host port for the database container (change it if 5432 is already taken).
POSTGRES_PORT=5432
# Use the same password and port here.
DATABASE_URL=postgres://agentic:<POSTGRES_PASSWORD>@localhost:5432/agentic_market

# API
API_PORT=3000
# Base URL the built-in agent uses to call the public API over loopback.
API_INTERNAL_BASE_URL=http://localhost:3000

# Secrets: random strings of at least 32 characters.
JWT_SECRET=
BUILTIN_KEY_SECRET=
# Password for the seeded demo users alice@demo.local and bob@demo.local.
SEED_DEMO_PASSWORD=

# Local AI (optional). Leave OLLAMA_BASE_URL empty to always use rule-based selection.
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=gemma4:e2b
# auto = AI with rule-based fallback; rules = always rule-based.
AGENT_SELECTION_MODE=auto
AI_TIMEOUT_MS=10000

# Simulated payments: prices whose cents equal this value are declined.
SIMULATED_DECLINE_CENTS=13

# Docker (full stack: docker compose --env-file .env.local up --build)
# Web app port (nginx) and Ollama port on the host.
WEB_PORT=8080
OLLAMA_PORT=11434
# Ollama URL seen from the API container. Leave empty for rule-based selection;
# set to http://ollama:11434 when starting with --profile ai.
DOCKER_OLLAMA_BASE_URL=
