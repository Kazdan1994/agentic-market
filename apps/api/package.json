{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "node dist/src/database/run-migrations.js",
    "migrate:revert": "node dist/src/database/run-migrations.js --revert",
    "seed": "node dist/src/database/seed/run-seed.js",
    "export:openapi": "nest build && node dist/src/scripts/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/cqrs": "12.1.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "5.5.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
